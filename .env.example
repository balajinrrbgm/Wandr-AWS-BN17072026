# =============================================================================
# Wandr — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# In production, set these via Vercel Dashboard → Settings → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Aurora PostgreSQL Serverless v2
# Use Vercel OIDC integration (recommended) or IAM credentials
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@your-aurora-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com:5432/wandr?sslmode=require"

# AWS region for Aurora cluster
AWS_REGION="eu-central-1"

# Aurora cluster resource ARN (for Data API, optional)
AURORA_CLUSTER_ARN="arn:aws:rds:eu-central-1:123456789012:cluster:wandr-aurora"

# Aurora secret ARN in Secrets Manager (for Data API, optional)
AURORA_SECRET_ARN="arn:aws:secretsmanager:eu-central-1:123456789012:secret:wandr-db-secret"

# -----------------------------------------------------------------------------
# Authentication — NextAuth.js
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-secret-here"

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# -----------------------------------------------------------------------------
# OpenAI — AI itinerary generation + embeddings
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-your-openai-api-key"

# Model selection
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# -----------------------------------------------------------------------------
# Stripe — Subscription billing
# Use test keys for development (sk_test_...), live keys for production (sk_live_...)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_EXPLORER="price_explorer_monthly_id"
STRIPE_PRICE_NOMAD="price_nomad_monthly_id"

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Wandr"

# Feature flags
NEXT_PUBLIC_ENABLE_PRICE_ALERTS="true"
NEXT_PUBLIC_ENABLE_COLLABORATION="true"
